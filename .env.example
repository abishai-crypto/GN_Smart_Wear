# Port (Render sets this automatically)
PORT=3000

# TiDB Cloud Serverless Connection Details (For Forever Storage)
# Kupata hizi details: Fungua tidbcloud.com -> Tengeneza Free Serverless Cluster -> Connect -> Node.js
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=glownest_db
